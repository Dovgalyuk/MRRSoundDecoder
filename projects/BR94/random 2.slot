# Coal shoveling
def init():
    while True:
        if not F_DRIVING:
            goto(stopped)

def stopped():
    V_TIMER_1S = rand(40, 120)
    while True:
        if V_TIMER_1S == 0:
            goto(playing)
        if F_DRIVING:
            goto(init)

def playing():
    V_TIMER_1S = 7
    await play("Coal shoveling init", 128, 128)
    while True:
        await play("Coal shoveling", 128, 128)
        if V_TIMER_1S == 0:
            goto(exit)
        if F_DRIVING:
            goto(exit)

def exit():
    await play("Coal shoveling exit", 128, 128)
    goto(init)
