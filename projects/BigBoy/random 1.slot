# Ventilation
def init():
    goto(stopped)

def stopped():
    V_TIMER_1S = rand(40, 80)
    while True:
        if V_TIMER_1S == 0:
            goto(playing)

def playing():
    V_TIMER_1S = 1
    while True:
        await play("Ventilation", 128, 128)
        if V_TIMER_1S == 0:
            goto(exit)

def exit():
    goto(init)
