# Blower
def init():
    while True:
        if not F_DRIVING:
            goto(stopped)

def stopped():
    V_TIMER_1S = rand(40, 80)
    await play("Blower init", 128, 128)
    while True:
        if V_TIMER_1S == 0:
            goto(playing)
        if F_DRIVING:
            goto(init)

def playing():
    V_TIMER_1S = 1
    while True:
        await play("Blower", 128, 128)
        if V_TIMER_1S == 0:
            goto(exit)
        if F_DRIVING:
            goto(exit)

def exit():
    await play("Blower exit", 128, 128)
    goto(init)
