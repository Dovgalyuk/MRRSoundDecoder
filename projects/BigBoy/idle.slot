# Boiler hiss
def init():
    while True:
        if F_FUNCTION:
            await play("Boiler hiss init", 128, 128)
            goto(playing)

def playing():
    def _immediate():
        if not F_FUNCTION:
            goto(exit)

    while True:
        await play("Boiler hiss", 128, 128)

def exit():
    await play("Boiler hiss exit", 128, 128)
    goto(init)
