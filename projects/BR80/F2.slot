# Conductor whistle
def init():
    while not F_FUNCTION:
        pass
    goto(playing)

def exit():
    goto(init)

def playing():
    def _immediate():
        if not F_FUNCTION:
            goto(exit)

    await play("Conductor whistle init", 128, 128)
    while F_FUNCTION:
        await play("Conductor whistle", 128, 128)
    await play("Conductor whistle exit", 128, 128)
    goto(exit)
